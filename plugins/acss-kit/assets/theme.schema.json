{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "acss-kit theme tokens",
  "description": "Internal-only contract for tokens_to_css.py / css_to_tokens.py. The user-facing authoring format is the CSS Token Convention documented in skills/styles/SKILL.md — users edit CSS theme files (light.css, dark.css, brand-*.css) directly. Not a user-facing contract; see references/theme-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "modes": {
      "type": "object",
      "description": "Light and dark palette definitions.",
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/$defs/palette" },
        "dark":  { "$ref": "#/$defs/palette" }
      }
    },
    "brands": {
      "type": "object",
      "description": "Optional named brand color overrides. Keys are brand slugs (e.g. 'forest'). Values override only primary/accent roles.",
      "additionalProperties": { "$ref": "#/$defs/brand-overrides" }
    },
    "spacing": {
      "$ref": "#/$defs/dimension-scale",
      "description": "Mode-independent spacing scale. Emitted as --space-<name>."
    },
    "rounded": {
      "$ref": "#/$defs/dimension-scale",
      "description": "Mode-independent corner-radius scale. Emitted as --radius-<name>."
    },
    "typography": {
      "type": "object",
      "description": "Mode-independent typography composites. Emitted as --font-<role>-<sub>.",
      "additionalProperties": { "$ref": "#/$defs/typography-token" }
    }
  },
  "$defs": {
    "dimension": {
      "type": "string",
      "pattern": "^(0|[0-9]*\\.?[0-9]+(px|em|rem))$",
      "description": "A length: 0, or a number with a px/em/rem unit (e.g. 0.5rem, 16px)."
    },
    "dimension-scale": {
      "type": "object",
      "description": "Map of scale-step name (xs, sm, md, …, full) to a dimension.",
      "additionalProperties": { "$ref": "#/$defs/dimension" }
    },
    "typography-token": {
      "type": "object",
      "description": "A typography composite. All sub-properties optional; size is a dimension.",
      "additionalProperties": false,
      "properties": {
        "family":   { "type": "string" },
        "size":     { "$ref": "#/$defs/dimension" },
        "weight":   { "type": "string", "description": "Numeric weight as a string, e.g. \"400\"." },
        "line":     { "type": "string", "description": "Unitless multiplier or a dimension, e.g. \"1.5\" or \"24px\"." },
        "tracking": { "type": "string", "description": "Letter-spacing, e.g. \"0.01em\"." }
      }
    },
    "hex-color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "description": "Hex color: #rrggbb or #rgb."
    },
    "palette": {
      "type": "object",
      "description": "Full set of semantic role tokens for one color mode.",
      "required": [
        "--color-background",
        "--color-surface",
        "--color-surface-raised",
        "--color-text",
        "--color-text-muted",
        "--color-text-inverse",
        "--color-border",
        "--color-border-strong",
        "--color-primary",
        "--color-primary-hover",
        "--color-success",
        "--color-warning",
        "--color-danger",
        "--color-info",
        "--color-focus-ring"
      ],
      "additionalProperties": false,
      "properties": {
        "--color-background":    { "$ref": "#/$defs/hex-color" },
        "--color-surface":       { "$ref": "#/$defs/hex-color" },
        "--color-surface-raised":{ "$ref": "#/$defs/hex-color" },
        "--color-surface-subtle":{ "$ref": "#/$defs/hex-color" },
        "--color-text":          { "$ref": "#/$defs/hex-color" },
        "--color-text-muted":    { "$ref": "#/$defs/hex-color" },
        "--color-text-inverse":  { "$ref": "#/$defs/hex-color" },
        "--color-text-subtle":   { "$ref": "#/$defs/hex-color" },
        "--color-border":        { "$ref": "#/$defs/hex-color" },
        "--color-border-strong": { "$ref": "#/$defs/hex-color" },
        "--color-primary":       { "$ref": "#/$defs/hex-color" },
        "--color-primary-hover": { "$ref": "#/$defs/hex-color" },
        "--color-success":       { "$ref": "#/$defs/hex-color" },
        "--color-warning":       { "$ref": "#/$defs/hex-color" },
        "--color-danger":        { "$ref": "#/$defs/hex-color" },
        "--color-info":          { "$ref": "#/$defs/hex-color" },
        "--color-focus-ring":    { "$ref": "#/$defs/hex-color" },
        "--color-brand-accent":  { "$ref": "#/$defs/hex-color" }
      }
    },
    "brand-overrides": {
      "type": "object",
      "description": "Brand color overrides. Only primary and accent roles. Background, text, and border roles must not appear here.",
      "additionalProperties": false,
      "properties": {
        "--color-primary":      { "$ref": "#/$defs/hex-color" },
        "--color-primary-hover":{ "$ref": "#/$defs/hex-color" },
        "--color-focus-ring":   { "$ref": "#/$defs/hex-color" },
        "--color-brand-accent": { "$ref": "#/$defs/hex-color" }
      }
    }
  }
}
